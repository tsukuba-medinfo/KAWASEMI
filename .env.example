# アプリケーション設定
APP_NAME="KAWASEMI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
# 認証Cookie(JWT/refresh)・CSRF CookieにSecure属性を付けるか。既定true。
# HTTPS終端が無いローカル開発でブラウザから直接ログインを試すときのみfalseにする。
# COOKIE_SECURE=true

# サーバ設定
HOST="0.0.0.0"
PORT=8000
# リバースプロキシ(nginx)のサブパス配下に置く場合のプレフィックス（例: "/kawasemi"）。
# 空ならルート直下（従来どおり）。nginx 側でこのパスを strip してもしなくても動く。
ROOT_PATH=""
# 入り口（使う人ごとに画面と権限の範囲を分ける。docs/roles_and_permissions.md「入り口」）。
# 同じアプリを ENTRY_ROLES を変えて複数起動し、nginx で振り分ける（docs/reverse_proxy.md §2.5）。
# 空なら入り口の区別なし（全役割を切り替えて使う。従来どおり）。
# 役割と入り口は1対1。ENTRY_ROLES には役割を1つ書く（admin / designer / collector / reviewer）。
# ENTRY_NAME="設計"
# ENTRY_ROLES="designer"
# 他の役割の入り口の URL（役割=URL をカンマ区切り）。使えない役割の画面へ誘導するときに出す。
# ENTRY_URLS="collector=https://host/collect/,reviewer=https://host/review/,admin=https://host/admin/"

# データベース設定
# SQLite（開発用）
DATABASE_URL="sqlite+aiosqlite:///./kawasemi.db"
# PostgreSQL（本番用）
# DATABASE_URL="postgresql+asyncpg://kawasemi:YOUR_PASSWORD_HERE@localhost:5432/kawasemi"
# PostgreSQL では、DSL の sql_extract と統計プロファイルの集計 SQL を流す読み取り専用ロールの DSN。
# 設定するとその DSN の別接続で、読み取り専用トランザクションの中で実行する。
# 未設定のとき、ENVIRONMENT=production ではこれらを実行しない（source_unavailable）。
# production 以外ではアプリのロールで読み取り専用トランザクションを張って動く。
# どちらも起動時と check_schema で警告する。
# ロールの作り方は docs/DEPLOYMENT.md の「読み取り専用ロール」。SQLite では不要。
# ENVIRONMENT を設定しないと既定は development なので、本番では ENVIRONMENT=production を必ず設定する。
# ロールには users / user_roles / roles / refresh_tokens / auth_events を読ませない（REVOKE 必須）。
# READONLY_DATABASE_URL="postgresql+asyncpg://kawasemi_ro:YOUR_PASSWORD_HERE@localhost:5432/kawasemi"
# 上の経路の文単位のタイムアウト（秒。PostgreSQL。0 で無効）
# READONLY_STATEMENT_TIMEOUT_SECONDS=60

# FHIR サーバ設定
FHIR_SERVER_URL="http://localhost:8080/fhir"
FHIR_SERVER_TIMEOUT=30
# FHIR サーバ認証。本番サーバは認証必須が一般的。
# none / bearer / basic のいずれか。認証値はここ（.env・gitignore済み）に置く。
FHIR_AUTH_MODE=none
# FHIR_AUTH_MODE=bearer のとき使用
# FHIR_BEARER_TOKEN=""
# FHIR_AUTH_MODE=basic のとき使用
# FHIR_BASIC_USERNAME=""
# FHIR_BASIC_PASSWORD=""

# 被験者ID解決 resolver（名寄せ）設定
# 実装は in-process の FHIR identifier resolver 1つ（backend の切り替えは無い）。
# 登録番号に対応する anchor key_type（FHIR では system|登録番号 で Patient を検索する）。
# KEY_RESOLVER_ANCHOR=trial_subject_no

# セキュリティ設定
# 重要: 本番環境では必ず以下のコマンドで安全なキーを生成してください
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# または scripts/generate_secret_key.py を実行してください
SECRET_KEY=""  # ここに生成した32文字以上のランダム文字列を設定
CSRF_SECRET_KEY=""  # CSRFトークン用（SECRET_KEYとは別のキーを使用）

# ログインのレート制限（IP単位）。
# RATE_LIMIT_LOGIN=5/minute

# ログイン失敗のスロットル。アカウント単位のロックではなく、(ユーザー名, クライアント IP) の組で
# 失敗を数える。第三者が他人のアカウントを締め出せず、応答からユーザー名の有無も分からない。
# 状態はプロセス内メモリ（複数ワーカーではワーカーごと）。リバースプロキシ配下では
# uvicorn の --proxy-headers と FORWARDED_ALLOW_IPS が必要（docs/reverse_proxy.md）。
# LOCKOUT_MAX_ATTEMPTS=5        # この回数連続で失敗した (ユーザー名, IP) の受け付けを止める
# LOCKOUT_DURATION_MINUTES=30   # 止める時間と失敗を数える窓（分）。経過後は自動解除

# JWTリフレッシュトークン。アクセストークン期限切れ後の再発行。
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=14   # リフレッシュトークン有効期限（日）

# CORS で許可するオリジン（スキーム付き、カンマ区切り。CORSMiddleware の allow_origins）。
# 画面と API を同じオリジンで使うだけなら設定不要。別オリジンのフロントから呼ぶときだけ書く。
# ALLOWED_HOSTS="https://example.org,https://app.example.org"

# リバースプロキシ配下で信頼するプロキシIP/CIDR。既定はローカルのみ。
# nginx 等が別ホスト/別コンテナの場合はプロキシの実IPを設定する（"*" は IP 詐称を許すため非推奨）。
# FORWARDED_ALLOW_IPS="127.0.0.1"

# Ollama AI設定
# AI機能フラグ（docs/ai_flags_spec.md 参照。旧 ENABLE_AI は廃止）
ENABLE_AI_DRAFTING=true   # 候補探索AI（所在AI案・手順書生成・取得プラン作成）
ENABLE_AI_EXTRACTION=true # 自動構造化AI（実行時の llm_extract / llm_judge）
OLLAMA_MODEL="qwen3.8:27b"
# OLLAMA_BASE_URL="http://localhost:11434"
# embedding（bge-m3）だけ別の Ollama へ向ける。空なら OLLAMA_BASE_URL を使う。
# 索引を作ったサーバと bge-m3 の digest（`ollama list`）が同じであること。違うなら索引を作り直す
# （build_info はモデル名しか照合しないので、違っても検索は黙って劣化するだけで止まらない）。
# EMBEDDING_BASE_URL="http://localhost:11434"
# LLM 1コールあたりのタイムアウト（秒）。ローカルLLMは叙述項目の生成に数百秒
# かかることがある。
# OLLAMA_TIMEOUT=900
# 設計ロール（臨床的意味・所在・手順書・DSL の生成）を vLLM（OpenAI 互換）で回す。
# 実行ロール（llm_extract / llm_judge / vision）と embedding は Ollama に残る。
# LLM_PROVIDER=vllm
# vLLM の既定ポート 8000 はアプリと重なるので、vLLM は --port 8100 で起動する前提にしている。
# VLLM_BASE_URL="http://localhost:8100"   # /v1 は付けない
# VLLM_MODEL="qwen3.8-27b"                # vLLM サーバの --served-model-name と同じ名前にする
# VLLM_MAX_TOKENS=32768                   # thinking を含む出力上限
# VLLM_TIMEOUT=3600
# **vLLM で thinking の長いモデルを回すときは LLM_TOTAL_TIMEOUT も上げる。** 既定の 600 秒は
# 設計ロールの全体デッドラインで、thinking の長いモデルでは1コールが 600 秒を超えることがあり、
# 既定のままだと1回目が打ち切られる。
# LLM_TOTAL_TIMEOUT=3600
# 手書き/スキャンPDF読取用のマルチモーダルモデル。空なら OLLAMA_MODEL を流用するが、
# OLLAMA_MODEL が画像入力に対応しているとは限らない。手書き同意書やスキャンPDFを読むなら
# 画像入力に対応したモデルをここに指定する
# OLLAMA_VISION_MODEL=""
# 索引の embedding モデル。索引を作った側（indexer）とクエリ側（本体）で同じであること。
# 違うと build_info.json の互換チェックで検索が is_searchable=false に縮退する（CONTRACT.md）。
# EMBEDDING_MODEL="bge-m3"

# --- 置き場所（本体と indexer で共通。この .env 1つを両方が読む） ---
# 施設固有の情報（定義書・接続レジストリ・キー種別・規則）の置き場所。雛形は site.example/。
# SITE_DIR="site"
# 実行で生まれるもの（索引の成果物・出力ファイル）の置き場所。
# VAR_DIR="var"
# 以下は空なら SITE_DIR / VAR_DIR から決まる（明示した値はそのまま使う）。
# DB_DEFINITION_DIR="site/db_definition"
# RESOURCE_INDEX_DIR="var/resource_index"
# CONNECTIONS_FILE="site/connections.yaml"
# KEY_TYPES_FILE="site/key_types.yaml"
# 様式ごとに典拠にしてよい規約文書（無ければ範囲を設けない）
# REFERENCE_SCOPES_FILE="site/reference_scopes.yaml"
# データ所在の AI 案に施設が足す規則（本体が読む。無ければ空の規則）
# LOCATION_RULES_FILE="site/location_rules.yaml"
# 様式ごとに集計の分母に入れる項目番号（無ければ項目番号を持つ項目すべて）
# TARGET_ITEMS_FILE="site/target_items.yaml"
# モデル名ごとに推論の options へ足す値（無ければ何も足さない）
# MODEL_OPTIONS_FILE="site/model_options.yaml"
# 索引の作り方に施設が足す規則（indexer が読む。無ければ施設に依らない既定）
# INDEXER_RULES_FILE="site/indexer_rules.yaml"
# 索引検索の足切り閾値（cosine）
# RESOURCE_INDEX_MIN_SCORE=0.5

# --- 接続 secret（connections.yaml の secret_ref: env:NAME が参照する） ---
# 例: 院内DWH の DSN（SQLAlchemy URL）。indexer の reflection と本体の取得の両方が使う。
# DWH_DSN=""

# ログ設定
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ファイル出力設定
QUESTIONNAIRE_OUTPUT_DIR="./output/questionnaires"
QUESTIONNAIRE_RESPONSE_OUTPUT_DIR="./output/questionnaire_responses"

# 収集者が「次の患者を受け取る」で得る担当（排他リース）の長さ（分）。操作のたびに延長される。
# CLAIM_LEASE_MINUTES=120

# 試行(trial)実行で使ってよい患者ID（カンマ区切り）。
# 設計者は担当（リース）を持たないので、
# trial-run で使えるのは**合成・デモ患者**に限る。空なら有効なリースのある患者だけになる。
# 例: TRIAL_RUN_PATIENT_IDS=DEMO-0001,DEMO-0002
TRIAL_RUN_PATIENT_IDS=
